# Template configuration. Copy to .env and fill in real values before using AI,
# email delivery or UJP. Commit this file freely: the real .env is ignored by
# git, so live secrets must never appear here or anywhere else in the repo.

# AI providers used by email_agent.py for inbound-reply negotiation.
# Gemini is preferred when a key is present; OpenAI and Groq are fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Groq (OpenAI-compatible API). Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional comma-separated fallback rotation (defaults to llama-3.1-8b-instant):
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Speech-to-text model used for voice-note invoice prompts:
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Business identity (dummy values -- replace with your real details)
BUSINESS_NAME=Test Company DOOEL
BUSINESS_TAX_ID=4030000000000
BUSINESS_ADDRESS=Test Street 1
BUSINESS_CITY=Skopje
BUSINESS_COUNTRY=MK
BUSINESS_EMAIL=dummy@email.com
BUSINESS_PHONE=070 000 000
SENDER_NAME=Example Sender

# Invoice defaults
DEFAULT_CURRENCY=MKD
DEFAULT_VAT_RATE=18
DEFAULT_PAYMENT_TERMS_DAYS=15
DEFAULT_AMOUNT_INCLUDES_VAT=false
DEFAULT_LANGUAGE=MK
DEFAULT_CHANNEL=Email
DEFAULT_SERVICE_DESCRIPTION=Professional services
INVOICE_PREFIX=NPL

# Email delivery options (optional)
# SMTP credentials support backward-compatible keys: SMTP_* is primary and
# EMAIL_SMTP_* is the legacy alias (dispatcher falls back automatically when
# SMTP_* is unset; SMTP_PORT defaults to 587).
# For SMTP/Gmail (use a Gmail app password, never your login password):
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
# Primary credential names used by api.py and email_agent.py:
SMTP_USERNAME=dummy@email.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=dummy@email.com
# Legacy aliases still honored by bot_service.py and the dispatcher:
# SMTP_USER=dummy@email.com
# SMTP_PASS=your-app-password
# Gmail IMAP reader used by email_agent.py. Gmail requires IMAP to be enabled:
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Development self-testing: reply to your own Saldora reminder from the same
# mailbox and the agent will answer it, routing the AI reply back to you.
# Set to false in production to ignore self-sent replies (default: true).
EMAIL_AGENT_ALLOW_SELF_TEST=true
# Legacy aliases (equivalent, shorter spelling; falls back automatically):
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=dummy@email.com
# EMAIL_SMTP_PASS=your-app-password
# Long legacy spelling used by the mock e-mail adapter (send_email):
# EMAIL_SMTP_USERNAME=dummy@email.com
# EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_SMTP_USE_TLS=true
# OR for Resend:
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# Verified sending domain. The outbound From header is formatted as
# "Saldora Billing <billing@saldora.ai>" (display name = BUSINESS_NAME).
# RESEND_FROM_EMAIL=billing@saldora.ai

# Local storage
DATA_DIR=data
TIMEZONE=Europe/Skopje
LOG_LEVEL=INFO

# SQLite persistence layer (database.py). Leave unset to use the default below.
# DATABASE_URL=sqlite:///data/saldora.db

# Signing secret for JWT access tokens (api.py). Always set a unique value in
# production; the built-in development fallback is public knowledge.
# JWT_SECRET=replace-with-a-long-random-string

# Field-level encryption of PII columns (models.EncryptedString, Fernet).
# Leave unset for local testing: a random key is generated once and persisted to
# data/db_encryption.key (git-ignored), so local data stays decryptable across
# restarts. For production, generate a key and set the variable instead:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DB_ENCRYPTION_KEY=

# Documenso e-Signature integration (api.py / documenso_client.py).
# The API key can also be saved per-account from Поставки → Documenso.
# Cloud default: https://app.documenso.com ; self-hosted example:
# DOCUMENSO_BASE_URL=https://sign.your-domain.mk
# DOCUMENSO_API_KEY=api_xxxxxxxxxxxxxxxx
# Optional shared secret configured on the Documenso webhook endpoint. When set,
# the X-Documenso-Secret header must match this value.
# DOCUMENSO_WEBHOOK_SECRET=replace-with-a-long-random-string
# Optional path to a Cyrillic-capable TTF used for generated PDFs.
# DOCUMENSO_PDF_FONT=C:/Windows/Fonts/DejaVuSans.ttf
